PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200
CLIENT_URLS=
ALLOW_DEV_OTP_IN_PRODUCTION=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nursery_store
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Preferred on free Render: Resend over HTTPS
RESEND_API_KEY=
EMAIL_FROM=Nursery Store <onboarding@resend.dev>

# Optional SMTP fallback:
# Use either SMTP_HOST/SMTP_PORT/SMTP_SECURE OR SMTP_SERVICE.
# Do not use both at the same time.
# Prefer Gmail SMTP on Render with host/port settings instead of port 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Nursery Store <your-email@gmail.com>

# Option A: provider shortcut, for example Gmail or Outlook365
SMTP_SERVICE=
# Option B: custom host/port values, for example Gmail / Hostinger / cPanel / company SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Nursery Store <your-email@example.com>
OTP_EXPIRES_MINUTES=10
