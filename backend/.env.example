PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200
CLIENT_URLS=
ALLOW_DEV_OTP_IN_PRODUCTION=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nursery_store
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Promailer email delivery
EMAIL_PROVIDER=promailer
PROMAILER_API_KEY=
PROMAILER_FROM_EMAIL=
PROMAILER_FROM_NAME=Uttarakhand Succulent
OTP_EXPIRES_MINUTES=10
